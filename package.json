{
  "name": "dsh-mcp-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP panel for DeepSeek Harness Web 0.2.2+: lists configured MCP servers with live status and their tools.",
  "engines": {
    "dsh": ">=0.2.2-alpha.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "scripts": {
    "test": "node tests/host.test.mjs"
  }
}
